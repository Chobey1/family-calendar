# Private HTTPS address provided by Tailscale Serve, without a trailing slash.
APP_URL=https://worleyserver.YOUR-TAILNET.ts.net
TZ=America/Chicago
# Generate a long random value. Used only for the first family setup.
SETUP_TOKEN=REPLACE-WITH-A-LONG-RANDOM-SECRET
POSTGRES_PASSWORD=REPLACE-WITH-A-DIFFERENT-LONG-RANDOM-SECRET
# preview stores emails for viewing inside the app; smtp sends them.
MAIL_MODE=preview
SMTP_HOST=mail.smtp2go.com
SMTP_PORT=2525
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
# Keep true when using Tailscale HTTPS. For localhost HTTP testing only, use false.
COOKIE_SECURE=true
# Bind to localhost and expose using Tailscale Serve.
BIND_ADDRESS=127.0.0.1
